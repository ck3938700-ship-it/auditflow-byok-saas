{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@auditflow/audit": ["packages/audit/src"],
      "@auditflow/db": ["packages/db/src"],
      "@auditflow/rag": ["packages/rag/src"],
      "@auditflow/workflow": ["packages/workflow/src"],
      "@/*": ["apps/web/*"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
